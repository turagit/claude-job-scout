{# schema:
   required:
     - data.title
     - data.subtitle
     - data.generated_at
     - data.filename
     - data.tier_counts
     - data.results
     - data.unread_count
   optional:
     - data.coverage
     - data.queued
     - data.reposts
     - data.near_misses
     - data.budget
     - data.run_status
     - data.no_scrape_reason
#}
<header class="report-header">
  <div class="icon">🔔</div>
  <div>
    <h1>{{ data.title }}</h1>
    <div class="subtitle">{{ data.subtitle }}</div>
  </div>
</header>

{% if data.run_status == 'no_scrape' %}
<div class="gated-banner" style="background:var(--surface-muted,#f5f5f5);border-left:3px solid var(--danger,#c0392b);padding:10px 14px;border-radius:4px;margin:12px 0">
  <strong>No fresh scrape</strong> — {{ data.no_scrape_reason or 'reason not recorded' }}. The tracker was not modified; below is an empty run.
</div>
{% endif %}
{% if data.coverage and data.coverage.rows %}
{% set t = data.coverage.totals or {} %}
{% set b = data.budget or {} %}
<details open style="margin:12px 0"><summary><strong>Alert coverage</strong> — {{ t.alerts or 0 }} alerts walked · {{ t.cards_seen or 0 }} cards · {{ t.new or 0 }} new{% if data.budget %} · JD budget {{ b.used or 0 }}/{{ b.limit or 0 }}{% if b.queued %} · {{ b.queued }} queued{% endif %}{% endif %}</summary>
<table class="dim-table" style="width:100%;margin-top:8px;font-size:13px;border-collapse:collapse">
  <tr><th style="text-align:left;padding:4px 8px">Alert</th><th style="padding:4px 8px">Pages</th><th style="padding:4px 8px">Stop</th><th style="padding:4px 8px">Cards</th><th style="padding:4px 8px">Exact</th><th style="padding:4px 8px">Known</th><th style="padding:4px 8px">Reposts</th><th style="padding:4px 8px">New</th></tr>
  {% for r in data.coverage.rows %}
  <tr class="dim-row"><td style="padding:4px 8px">{{ r.keywords }}<div style="font-size:11px;color:var(--text-muted)">since {{ r.since }}{% if r.status != 'complete' %} · <strong>partial</strong>{% endif %}</div></td><td style="text-align:center">{{ r.pages_walked }}</td><td style="text-align:center">{{ r.stop_reason or '—' }}</td><td style="text-align:center">{{ r.cards_seen }}</td><td style="text-align:center">{{ r.before_divider }}</td><td style="text-align:center">{{ r.known }}</td><td style="text-align:center">{{ r.reposts }}</td><td style="text-align:center"><strong>{{ r.new }}</strong></td></tr>
  {% endfor %}
</table></details>
{% endif %}

{% if data.results %}
<div class="toolbar">
  <button data-sort="date" class="active">Latest ↓</button>
  <span style="flex:1"></span>
  <button data-filter="all" data-filter-attr="seen" class="active">All ({{ data.tier_counts.total }})</button>
  <button data-filter="false" data-filter-attr="seen">Unread ({{ data.unread_count }})</button>
  <button data-filter="A" data-filter-attr="tier">A-tier ({{ data.tier_counts.a }})</button>
  <button data-filter="B" data-filter-attr="tier">B-tier ({{ data.tier_counts.b }})</button>
  <button data-filter="C" data-filter-attr="tier">C-tier ({{ data.tier_counts.c }})</button>
  <button data-filter="D" data-filter-attr="tier">Filtered ({{ data.tier_counts.d }})</button>
</div>

<section>
{% for note in data.results %}
  <article id="note-{{ note.id }}" class="event-card" data-tier="{{ note.tier }}" data-seen="{% if note.seen %}true{% else %}false{% endif %}" data-sort_date="{{ note.received_at }}">
    {% if note.gate_violations and note.gate_violations|length > 0 %}
      <div class="gated-banner" style="background:var(--surface-muted,#f5f5f5);border-left:3px solid var(--danger,#c0392b);padding:8px 12px;border-radius:4px;font-size:13px">
        🚫 Filtered out — {% for v in note.gate_violations %}<strong>{{ v.kind }}</strong>{% if v.detail %} ({{ v.detail }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
      </div>
      <div class="meta" style="margin-top:6px;font-size:12px;color:var(--text-muted)">{{ note.title }} · {{ note.company }}{% if note.source %} · <span class="tag-chip">{{ note.source }}</span>{% endif %}</div>
    {% else %}
      <div class="header">
        <div class="title">{{ note.title }}{% if note.fresh %} <span class="tag-chip" style="background:var(--accent-from);color:#fff">⚡ apply early</span>{% endif %}</div>
        <div class="score-pill tier-{{ note.tier|lower }}">{{ note.tier }}</div>
      </div>
      <div class="meta">{{ note.company }}{% if note.location %} · {{ note.location }}{% endif %} · {{ note.received_at }}{% if note.source %} · <span class="tag-chip">{{ note.source }}</span>{% endif %}{% if note.url %} · <a href="{{ note.url }}" target="_blank" rel="noopener noreferrer" style="color:var(--accent-from);text-decoration:none;font-weight:600">View posting ↗</a>{% endif %}</div>
      {% if note.tier in ['A', 'B'] and (note.competitiveness or note.confidence or note.match_explanation_tag) %}
      <div class="signal-badges" style="margin-bottom:8px">
        {% if note.match_explanation_tag %}<span class="tag-chip accent">{{ note.match_explanation_tag|replace('-', ' ') }}</span>{% endif %}
        {% if note.competitiveness %}<span class="tag-chip" title="{{ note.competitiveness_evidence or '' }}">🎯 competitiveness: {{ note.competitiveness }}</span>{% endif %}
        {% if note.confidence %}<span class="tag-chip">confidence: {{ note.confidence }}</span>{% endif %}
      </div>
      {% endif %}
      {% if note.preview %}<div style="font-size:13px;color:var(--text-muted);margin-top:6px">{{ note.preview }}</div>{% endif %}
      {% if note.dimensions %}
      <table class="dim-table" style="width:100%;margin-top:10px;font-size:13px;border-collapse:collapse">
        {% for dim_name, dim in note.dimensions.items() %}
        <tr class="dim-row dim-tier-{{ dim.tier }}">
          <th style="text-align:left;padding:4px 8px;font-weight:600;color:var(--text-strong);white-space:nowrap">{{ dim_name }}</th>
          <td style="padding:4px 8px;width:32px"><span class="tier-badge tier-{{ dim.tier|lower }}" style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:700">{{ dim.tier }}</span></td>
          <td class="evidence" style="padding:4px 8px;color:var(--text-muted);font-style:italic">{% for q in dim.evidence[:2] %}"{{ q }}"{% if not loop.last %}<br/>{% endif %}{% endfor %}</td>
        </tr>
        {% endfor %}
      </table>
      {% endif %}
      <div style="margin-top:8px"><button class="copy-btn" data-mark-read="note-{{ note.id }}">{% if note.seen %}Mark unread{% else %}Mark read{% endif %}</button></div>
    {% endif %}
  </article>
{% endfor %}
</section>
{% endif %}
{% if data.near_misses %}
<details style="margin:12px 0"><summary><strong>Would you bend?</strong> — {{ data.near_misses|length }} near miss{% if data.near_misses|length != 1 %}es{% endif %}</summary>
<ul>{% for j in data.near_misses %}{% set fg = j.failed_gate or {} %}<li><strong>{{ j.title }}</strong> · {{ j.company }} · {{ j.location }} — would be <strong>{{ j.would_be_tier }}</strong>; failed <strong>{{ fg.kind or 'unknown' }}</strong>{% if fg.detail %} ({{ fg.detail }}){% endif %} · <code>{{ j.bend_hint }}</code>{% if j.url %} · <a href="{{ j.url }}" target="_blank" rel="noopener noreferrer">View posting ↗</a>{% endif %}</li>{% endfor %}</ul></details>
{% endif %}
{% if data.queued %}
<details style="margin:12px 0"><summary><strong>Queued for tomorrow</strong> — {{ data.queued|length }} role{% if data.queued|length != 1 %}s{% endif %} over the JD budget</summary>
<ul>{% for j in data.queued %}<li>{{ j.title }} · {{ j.company }} · {{ j.location }}{% if j.url %} · <a href="{{ j.url }}" target="_blank" rel="noopener noreferrer">View posting ↗</a>{% endif %}</li>{% endfor %}</ul></details>
{% endif %}
{% if data.reposts %}
<details style="margin:12px 0"><summary><strong>Treated as reposts</strong> — {{ data.reposts|length }} skipped by fingerprint (both IDs shown; open one if it looks wrong)</summary>
<ul>{% for r in data.reposts %}<li>{{ r.title }} · {{ r.company }} · {{ r.location }} — new id <code>{{ r.id }}</code> matched tracked <code>{{ r.matched_id }}</code></li>{% endfor %}</ul></details>
{% endif %}
{% if data.results %}
{% else %}
<div class="empty-state">
  <div class="icon">🔕</div>
  <div class="title">No notifications today.</div>
  <div class="hint">Make sure your LinkedIn alerts are still active — `/create-alerts` can derive a fresh set from your query plan.</div>
</div>
{% endif %}
